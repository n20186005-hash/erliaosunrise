{
  "name": "erliao-sunrise",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "pnpm build && wrangler dev",
    "dev:astro": "astro dev",
    "build": "pnpm check && astro build",
    "preview": "pnpm dev",
    "worker:dev": "pnpm dev",
    "deploy": "pnpm build && wrangler deploy",
    "check": "astro check && tsc --noEmit -p worker/tsconfig.json"
  },
  "dependencies": {
    "astro": "7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "4.115.0"
  }
}
