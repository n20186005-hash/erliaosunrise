{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "erliaosunrise",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
