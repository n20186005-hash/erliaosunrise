---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { nearby } from '../../data/nearby';

export function getStaticPaths() {
  return nearby.map((place) => ({ params: { slug: place.slug }, props: { place } }));
}

const { place } = Astro.props;
const url = `https://erliaosunrise.com/nearby/${place.slug}/`;
const title = `${place.name}｜二寮觀日亭周邊景點、交通與遊覽路線`;
const description = `${place.summary}整理基本資料、歷史特色、交通方式、參觀重點、拍照建議與二寮日出順遊路線。`;
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'TouristAttraction', name: place.name,
  alternateName: place.en, description: place.summary, url, hasMap: place.maps,
  address: { '@type': 'PostalAddress', streetAddress: place.address, addressCountry: 'TW' },
  subjectOf: { '@type': 'WebPage', url }
}, {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://erliaosunrise.com/' },
    { '@type': 'ListItem', position: 2, name: '周邊景點', item: 'https://erliaosunrise.com/nearby/' },
    { '@type': 'ListItem', position: 3, name: place.name, item: url }
  ]
}];
---
<BaseLayout title={title} description={description} canonical={`/nearby/${place.slug}/`} jsonLd={jsonLd}>
  <section class="bg-forest-950 pb-20 pt-32 text-white sm:pt-40">
    <div class="site-container">
      <nav aria-label="麵包屑" class="text-sm text-white/65"><a href="/">首頁</a> / <a href="/nearby/">周邊景點</a> / {place.name}</nav>
      <p class="eyebrow mt-8"><Icon name="mountain" size={16} /> {place.type}</p>
      <h1 class="mt-5 max-w-4xl font-serif text-[clamp(2.6rem,7vw,5rem)] font-bold leading-tight">{place.name}</h1>
      <p class="mt-3 text-lg text-sun-300">{place.en}</p>
      <p class="mt-7 max-w-3xl text-base leading-8 text-white/75">{place.summary}</p>
      <div class="mt-8 flex flex-wrap gap-3"><a class="sun-button" href={place.maps} target="_blank" rel="noopener noreferrer"><Icon name="route" size={18} /> Google 地圖位置</a><a class="outline-button" href="/nearby/">探索其他周邊景點</a></div>
    </div>
  </section>
  <section class="bg-sand-50 py-16 sm:py-24"><div class="site-container grid gap-12 lg:grid-cols-[1.1fr_.9fr]">
    <div><p class="eyebrow">探索景點</p><h2 class="section-title">從二寮日出，走進{place.name}。</h2><p class="mt-6 leading-8 text-forest-700">{place.history}</p>
      <h3 class="mt-9 font-serif text-2xl font-bold">遊覽建議</h3><p class="mt-3 leading-8 text-forest-700">建議停留 {place.visit}。{place.transport}</p>
      <h3 class="mt-8 font-serif text-2xl font-bold">景區特色與觀察重點</h3><ul class="mt-4 grid gap-3">{place.features.map((feature) => <li class="paper-card p-5 text-sm leading-7 text-forest-700">{feature}</li>)}</ul>
      <h2 class="mt-12 font-serif text-3xl font-bold">關於{place.name}</h2><p class="mt-4 leading-8 text-forest-700">{place.summary} 本頁以左鎮、新化觀光路線與公開景點資料整理，適合與二寮觀日亭安排同日順遊；實際開放與道路狀況以現場公告為準。</p>
      <h2 class="mt-10 font-serif text-3xl font-bold">基本資料</h2><dl class="mt-5 divide-y divide-forest-900/10 rounded-3xl bg-white px-6"><div class="grid gap-2 py-5 sm:grid-cols-[8rem_1fr]"><dt class="font-bold">名稱</dt><dd>{place.name}（{place.en}）</dd></div><div class="grid gap-2 py-5 sm:grid-cols-[8rem_1fr]"><dt class="font-bold">類型</dt><dd>{place.type}</dd></div><div class="grid gap-2 py-5 sm:grid-cols-[8rem_1fr]"><dt class="font-bold">位置</dt><dd>{place.address}</dd></div><div class="grid gap-2 py-5 sm:grid-cols-[8rem_1fr]"><dt class="font-bold">停留時間</dt><dd>{place.visit}</dd></div><div class="grid gap-2 py-5 sm:grid-cols-[8rem_1fr]"><dt class="font-bold">開放及費用</dt><dd>依各管理單位及現場公告核實；本頁不提供未核實的即時票價。</dd></div></dl>
    </div>
    <aside class="space-y-5"><div class="paper-card p-7"><h2 class="font-serif text-2xl font-bold">交通方式</h2><p class="mt-4 leading-7 text-forest-700">{place.transport}</p><a class="mt-6 inline-flex font-bold text-forest-900 underline" href={place.maps} target="_blank" rel="noopener noreferrer">查看專屬 Google 地圖 <Icon name="external" size={15} /></a></div><div class="paper-card p-7"><h2 class="font-serif text-2xl font-bold">出發前核對</h2><p class="mt-4 leading-7 text-forest-700">{place.note}</p><p class="mt-4 text-sm text-forest-700">公開資料：<a class="underline" href={place.source} target="_blank" rel="noopener noreferrer">景點／旅遊資訊原始頁</a></p></div></aside>
  </div></section>
  <section class="bg-white py-16 sm:py-24"><div class="site-container"><p class="eyebrow">遊覽路線</p><h2 class="section-title">從二寮出發的順遊安排</h2><ol class="mt-9 grid gap-4 md:grid-cols-3">{place.route.map((step, i) => <li class="paper-card p-6"><span class="text-3xl font-serif font-bold text-sun-500">{String(i+1).padStart(2,'0')}</span><p class="mt-4 leading-7 text-forest-700">{step}</p></li>)}</ol><div class="mt-10 grid gap-8 lg:grid-cols-2"><div><h2 class="font-serif text-2xl font-bold">拍照機位與注意事項</h2><p class="mt-3 leading-8 text-forest-700">{place.photo}</p></div><div><h2 class="font-serif text-2xl font-bold">住宿與補給</h2><p class="mt-3 leading-8 text-forest-700">若安排日出前一晚住宿，可考慮新化、左鎮或臺南市區，但須自行核對夜間出發時間、交通與住宿規定；別假設山區觀景點可露營。</p></div></div></div></section>
  <section class="bg-sand-100 py-16"><div class="site-container"><h2 class="section-title">常見問題</h2><div class="mt-7 space-y-4"><details class="paper-card p-6"><summary class="cursor-pointer font-bold">適合與二寮日出排在同一天嗎？</summary><p class="mt-4 leading-7 text-forest-700">可以。先完成日出觀賞，天亮後再前往；如遇館舍，請先確認當天開館時間。</p></details><details class="paper-card p-6"><summary class="cursor-pointer font-bold">是否可以直接用二寮導航點前往？</summary><p class="mt-4 leading-7 text-forest-700">不行。各景點都有獨立位置，請使用本頁的專屬 Google 地圖按鈕。</p></details><details class="paper-card p-6"><summary class="cursor-pointer font-bold">需要事先確認什麼？</summary><p class="mt-4 leading-7 text-forest-700">{place.note}</p></details></div><a class="sun-button mt-9" href="/nearby/">查看完整周邊景點指南</a></div></section>
</BaseLayout>
