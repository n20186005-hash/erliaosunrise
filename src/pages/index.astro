---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConditionsPanel from '../components/ConditionsPanel.astro';
import SunriseNow from '../components/SunriseNow.astro';
import Icon from '../components/Icon.astro';

const title = '二寮觀日亭日出時間｜即時影像、雲海季節與交通停車攻略';
const description = '【每日更新】台南二寮觀日亭（臺南左鎮）今日與明日日出時間、即時影像與現場天氣、雲海最佳月份、開車路線與停車指引，並整理草山月世界、左鎮化石園區等順遊路線。';

const mapsShareUrl = 'https://maps.app.goo.gl/KVSX2Gm83RceQEGh6';
const ratingSyncNote = '同步自 Google 地圖用戶評價，同步時間 2026 年 9 月；版權歸原作者與 Google 地圖所有。';

const faqs = [
  {
    question: '今天二寮日出時間是幾點？',
    answer: '二寮的日出時間每天不同：夏季約 05:10–05:30，春、秋季約 05:45–06:10，冬季約 06:30–06:50。本頁首頁會依觀日亭座標即時計算「今日日出」與「明日日出」，下方觀景條件面板則會搭配當日天氣給出建議抵達時間；要以官方數據為準時，可再對照交通部中央氣象署的日出日沒時刻。'
  },
  {
    question: '二寮觀日亭有即時影像嗎？在哪裡看？',
    answer: '有。本站「二寮觀日亭即時影像與氣候現況」區塊直接嵌入觀日平臺的即時影像，可用來確認現場是否有霧、雲層厚薄與天色；另可前往西拉雅國家風景區管理處的即時影像頁面查看官方訊號。影像可能因天候、設備或網路狀況暫時中斷。'
  },
  {
    question: '二寮觀日亭在哪裡？要怎麼去？',
    answer: '台南二寮觀日亭位於臺南市左鎮區二寮，屬西拉雅國家風景區範圍，座標 22.9927444, 120.4098726。最實際的方式是自駕，直接導航上述座標（比輸入地址精準）；從臺南市區出發車程約 50–60 分鐘。夜間山路照明有限、彎道多，請降低車速並避免單憑地址導航。'
  },
  {
    question: '二寮觀日亭需要門票或預約嗎？',
    answer: '目前官方景點資訊標示為免門票、全天開放。特殊活動、道路施工、天候或節慶交通管制仍可能影響通行，出發前應查看最新公告。'
  },
  {
    question: '現場可以買到食物或飲料嗎？',
    answer: '觀日亭清晨可能有行動攤販供應熱食與飲品，依當日擺攤情況而定；建議出發前先用餐或自備熱飲保溫瓶。鄰近的左鎮與新化市區亦有便利商店與餐飲店家可補給。'
  },
  {
    question: '應該在日出前多久抵達？',
    answer: '第一次前往建議在日出前 60 至 90 分鐘抵達。除了預留停車與步行時間，也能在天色漸亮時確認構圖；攝影旺季或連假則應再提早。'
  },
  {
    question: '什麼季節最容易看到二寮日出與雲海？',
    answer: '官方建議通常以 6 月至 9 月為較佳觀賞季節，雨後隔日也較可能出現晨霧與雲海，但這不是保證。雲層、濕度、風向與能見度都會影響結果。'
  },
  {
    question: '沒有開車也能前往嗎？',
    answer: '可以安排計程車或包車，但清晨大眾運輸通常難以配合日出時間。若搭公車到岡林一帶，仍須步行一段山路，應先核對最新班次與回程方式。'
  },
  {
    question: '現場有停車場與廁所嗎？',
    answer: '西拉雅國家風景區資料列有停車與廁所設施。實際可用狀態、容量與臨時交管可能改變，夜間行車及停車時請勿阻礙道路。'
  },
  {
    question: '二寮日出一定看得到嗎？',
    answer: '不一定。二寮最迷人的景觀來自陽光、山稜、低層雲霧與能見度同時配合。本站指數只能協助判斷，出發前仍應查看官方即時影像。'
  }
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TouristAttraction',
    '@id': 'https://erliaosunrise.com/#attraction',
    name: '台南二寮觀日亭',
    alternateName: ['二寮日出', '二寮觀日平臺', '台南二寮觀日亭', 'Erliao Sunrise Pavilion'],
    description,
    url: 'https://erliaosunrise.com/',
    image: [
      'https://erliaosunrise.com/images/hero-erliao-sunrise.webp',
      'https://erliaosunrise.com/images/erliao-platform.webp',
      'https://erliaosunrise.com/images/erliao-mist.webp'
    ],
    isAccessibleForFree: true,
    openingHours: 'Mo-Su 00:00-23:59',
    geo: {
      '@type': 'GeoCoordinates',
      latitude: 22.9927444,
      longitude: 120.4098726
    },
    hasMap: mapsShareUrl,
    address: {
      '@type': 'PostalAddress',
      streetAddress: '二寮（XCV5+3W 左鎮區）',
      addressLocality: '左鎮區',
      addressRegion: '臺南市',
      postalCode: '713',
      addressCountry: 'TW'
    },
    touristType: ['攝影旅人', '自駕旅人', '自然景觀旅人'],
    sameAs: [
      mapsShareUrl,
      'https://www.siraya-nsa.gov.tw/zh-tw/attractions/detail/30',
      'https://www.twtainan.net/zh-tw/attractions/detail/569/'
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '臺南市', item: 'https://erliaosunrise.com/#tainan' },
      { '@type': 'ListItem', position: 2, name: '左鎮區', item: 'https://erliaosunrise.com/#zuozhen' },
      { '@type': 'ListItem', position: 3, name: '台南二寮觀日亭', item: 'https://erliaosunrise.com/#attraction' }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer }
    }))
  }
];
---
<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/hero-erliao-sunrise.webp" fetchpriority="high" />
  </Fragment>

  <section class="grain relative min-h-[820px] overflow-hidden bg-forest-950 text-white sm:min-h-[850px]">
    <img
      class="absolute inset-0 h-full w-full object-cover object-[56%_48%]"
      src="/images/hero-erliao-sunrise.webp"
      alt="台南二寮觀日亭清晨日出穿過山谷薄霧與竹林（臺南市左鎮區）"
      width="1920"
      height="1280"
      fetchpriority="high"
    />
    <div class="hero-shade absolute inset-0"></div>

    <div class="site-container relative flex min-h-[820px] flex-col justify-center pb-36 pt-32 sm:min-h-[850px]">
      <div class="max-w-[45rem]">
        <div class="flex flex-wrap gap-2 text-xs font-extrabold tracking-wide">
          <span class="rounded-full border border-white/25 bg-white/10 px-3 py-1.5 backdrop-blur">臺南・左鎮</span>
          <span class="rounded-full border border-white/25 bg-white/10 px-3 py-1.5 backdrop-blur">全天開放・免門票</span>
          <span class="rounded-full border border-white/25 bg-white/10 px-3 py-1.5 backdrop-blur">低海拔雲海日出</span>
        </div>
        <p class="mt-6 text-sm font-extrabold tracking-[0.22em] text-sun-300">臺南市左鎮區・二寮觀日平臺</p>
        <h1 class="mt-4">
          <span class="block font-serif text-[clamp(1.35rem,4.4vw,2.15rem)] font-bold leading-[1.2] tracking-[-.01em] text-sun-300">台南二寮觀日亭・今日日出時間</span>
          <span class="mt-3 block max-w-[9ch] font-serif text-[clamp(2.9rem,8.6vw,6rem)] font-bold leading-[1] tracking-[-.06em] text-white">天亮以前，先來二寮。</span>
        </h1>
        <p class="mt-6 max-w-2xl text-base font-medium leading-8 text-white/72 sm:text-lg">在左鎮月世界的丘陵與竹林之上，等待第一道斜光穿過谷地晨霧。先看日出時間與現場條件，再決定今晚要不要出發。</p>
        <SunriseNow />
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a class="sun-button" href="#conditions"><Icon name="sunrise" size={19} />查看明早觀景條件</a>
          <a class="outline-button" href="#live"><Icon name="camera" size={18} />查看即時影像</a>
        </div>
      </div>

      <a class="absolute bottom-9 left-4 inline-flex items-center gap-3 text-sm font-bold text-white/58 transition hover:text-white sm:left-auto" href="#conditions">
        <span class="grid size-10 place-items-center rounded-full border border-white/25"><Icon name="arrowDown" size={17} /></span>
        往下規劃行程
      </a>
    </div>

    <div class="absolute inset-x-0 bottom-0 border-t border-white/15 bg-black/15 backdrop-blur-md">
      <div class="site-container grid grid-cols-2 divide-x divide-white/15 sm:grid-cols-4">
        <div class="px-3 py-5 sm:px-6"><p class="text-[.66rem] font-bold tracking-widest text-white/45">建議停留</p><p class="mt-1 font-serif text-xl font-bold">1–2 小時</p></div>
        <div class="px-3 py-5 sm:px-6"><p class="text-[.66rem] font-bold tracking-widest text-white/45">推薦季節</p><p class="mt-1 font-serif text-xl font-bold">6–9 月</p></div>
        <div class="hidden px-6 py-5 sm:block"><p class="text-[.66rem] font-bold tracking-widest text-white/45">座標</p><p class="mt-1 font-serif text-xl font-bold">22.9927°N</p></div>
        <div class="hidden px-6 py-5 sm:block"><p class="text-[.66rem] font-bold tracking-widest text-white/45">出發方式</p><p class="mt-1 font-serif text-xl font-bold">自駕優先</p></div>
      </div>
    </div>
  </section>

  <ConditionsPanel />

  <section id="live" class="bg-forest-950 py-20 text-white sm:py-28">
    <div class="site-container">
      <div class="reveal flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow"><Icon name="camera" size={16} /> 二寮即時影像</p>
          <h2 class="section-title text-white">二寮觀日亭即時影像與氣候現況</h2>
        </div>
        <p class="max-w-md text-sm leading-7 text-white/58">出發前先看此刻的二寮：確認谷地是否有霧、雲層厚薄與現場天色。影像可能因天候、設備或網路狀況暫時中斷，畫面時間請以播放器顯示為準。</p>
      </div>
      <div class="reveal mt-10 overflow-hidden rounded-[2rem] border border-white/10 bg-black shadow-[0_32px_90px_rgba(0,0,0,.28)]">
        <div class="aspect-video">
          <iframe
            class="h-full w-full"
            src="https://www.youtube.com/embed/xbojeDKjcaM?mute=1&amp;autoplay=1&amp;playsinline=1"
            title="二寮觀日平臺即時影像"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
          ></iframe>
        </div>
      </div>
      <div class="reveal mt-5 flex flex-wrap gap-3">
        <a class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[.06] px-4 py-2.5 text-sm font-bold text-white/75 transition hover:border-white/35 hover:text-white" href="https://www.siraya-nsa.gov.tw/zh-tw/service/live-camera/1" target="_blank" rel="noopener noreferrer">西拉雅國家風景區管理處・二寮即時影像 <Icon name="external" size={14} /></a>
        <a class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[.06] px-4 py-2.5 text-sm font-bold text-white/75 transition hover:border-white/35 hover:text-white" href="https://www.cwa.gov.tw/" target="_blank" rel="noopener noreferrer">交通部中央氣象署・天氣與日出日沒時刻 <Icon name="external" size={14} /></a>
      </div>
    </div>
  </section>

  <section id="about" class="bg-sand-50 py-20 sm:py-28">
    <div class="site-container">
      <nav aria-label="景點位置" class="reveal">
        <ol class="flex flex-wrap items-center gap-2 text-sm font-bold text-forest-700">
          <li>台灣</li>
          <li aria-hidden="true" class="text-sun-500">→</li>
          <li>臺南市</li>
          <li aria-hidden="true" class="text-sun-500">→</li>
          <li>左鎮區</li>
          <li aria-hidden="true" class="text-sun-500">→</li>
          <li class="text-forest-950">台南二寮觀日亭</li>
        </ol>
      </nav>

      <div class="mt-9 grid gap-12 lg:grid-cols-[1.05fr_.95fr] lg:gap-20">
        <div class="reveal">
          <p class="eyebrow"><Icon name="sun" size={16} /> 關於景點</p>
          <h2 class="section-title">台南二寮觀日亭（Erliao Sunrise Pavilion）</h2>
          <div class="mt-7 space-y-5 section-copy">
            <p>歡迎來到<strong>台南二寮觀日亭</strong>，也就是旅人熟知的<strong>「二寮日出」</strong>與二寮觀日平臺所在。它位於臺灣臺南市左鎮區的月世界丘陵之間，鄰近西拉雅國家風景區，是造訪台南山區時最具代表性的日出觀賞據點之一。</p>
            <p>前往台南二寮觀日亭時，旅人可順道探索周邊歷史地標與景點，包括<strong>草山月世界</strong>的惡地地形景觀，以及<strong>左鎮化石園區</strong>的化石與地質展覽。</p>
          </div>
          <div class="mt-9 flex flex-col gap-4 sm:flex-row sm:items-center">
            <a class="sun-button" href={mapsShareUrl} target="_blank" rel="noopener noreferrer"><Icon name="mapPin" size={18} />在 Google 地圖查看景點</a>
            <a class="inline-flex items-center gap-1 text-sm font-extrabold text-forest-700 underline decoration-sand-200 underline-offset-4 hover:text-forest-950" href="#transport">交通與停車資訊 <Icon name="chevron" size={15} /></a>
          </div>
        </div>

        <div class="reveal space-y-4">
          <dl class="paper-card grid grid-cols-[6.5rem_1fr] gap-x-4 gap-y-3 p-6 text-sm leading-6 sm:p-7">
            <dt class="font-bold text-forest-700">景點類型</dt><dd>景觀區</dd>
            <dt class="font-bold text-forest-700">地址</dt><dd>713 台灣臺南市左鎮區二寮</dd>
            <dt class="font-bold text-forest-700">座標</dt><dd>22.9927444, 120.4098726</dd>
            <dt class="font-bold text-forest-700">開放時間</dt><dd>全天開放</dd>
            <dt class="font-bold text-forest-700">門票</dt><dd>免費（依現場公告為準）</dd>
          </dl>
          <div class="paper-card p-6 sm:p-7">
            <h3 class="font-serif text-xl font-bold">歷史與意義</h3>
            <p class="mt-3 text-sm leading-7 text-forest-700">「二寮」之名相傳源自早年拓墾時期依序搭建的草寮。2010 年代起經攝影社群推廣，二寮以「最接近城市的低海拔雲海日出」聞名全台；西拉雅國家風景區管理處並在此設置觀日平臺、停車與廁所等設施，讓清晨追光更容易安排。</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="overflow-hidden bg-white py-20 sm:py-32">
    <div class="site-container grid items-center gap-12 lg:grid-cols-[1.05fr_.95fr] lg:gap-20">
      <div class="photo-frame reveal aspect-[4/3] lg:aspect-[5/6]">
        <img src="/images/erliao-mist.webp" alt="台南二寮觀日亭山谷竹林間的金色晨霧" width="1280" height="853" loading="lazy" />
      </div>
      <div class="reveal">
        <p class="eyebrow"><Icon name="mountain" size={16} /> 最接近城市的曙光</p>
        <h2 class="section-title">不是只看太陽，而是等一幅山水畫醒來。</h2>
        <div class="mt-7 space-y-5 section-copy">
          <p>二寮的辨識度，來自月世界地形、竹林、山稜與谷底水氣。當晨光從東方切入，薄霧會把丘陵分成遠近不同的層次，形成攝影者熟悉的斜射光景觀。</p>
          <p>這裡海拔不高，不必攀登高山；代價是你仍要在深夜行車、在天亮前抵達，並接受每天景色都不同。沒有霧、雲太厚或風太強，都可能讓期待落空。</p>
        </div>
        <div class="mt-9 grid grid-cols-2 gap-4">
          <div class="paper-card p-5"><Icon name="sunrise" class="text-sun-500" /><p class="mt-4 font-extrabold">日出與斜射光</p><p class="mt-2 text-sm leading-6 text-forest-700">太陽越過山稜後，光線穿過晨霧與竹林。</p></div>
          <div class="paper-card p-5"><Icon name="cloud" class="text-sun-500" /><p class="mt-4 font-extrabold">低層雲霧</p><p class="mt-2 text-sm leading-6 text-forest-700">雨後、水氣與微風配合時，谷地更有層次。</p></div>
        </div>
      </div>
    </div>
  </section>

  <section id="guide" class="bg-sand-100 py-20 sm:py-32">
    <div class="site-container">
      <div class="reveal max-w-3xl">
        <p class="eyebrow"><Icon name="clock" size={16} /> 第一次前往</p>
        <h2 class="section-title">把抵達時間，倒著安排。</h2>
        <p class="section-copy mt-6">二寮不是到了才開始看。從黑暗、藍調到第一道金光，整段清晨都值得保留。以下時間以當日日出為基準，不是固定鐘點。</p>
      </div>

      <div class="mt-14 grid gap-5 lg:grid-cols-4">
        {[
          { time: '日出前 90 分', title: '抵達停車', copy: '旺季更早。留時間熟悉入口、如廁與確認回程道路。', icon: 'car' },
          { time: '日出前 60 分', title: '找到觀景位置', copy: '使用頭燈，避免用強光直照他人與攝影器材。', icon: 'mapPin' },
          { time: '日出前 30 分', title: '天色開始轉變', copy: '先觀察東方雲層與谷底霧氣，不必只盯著太陽。', icon: 'cloud' },
          { time: '日出後 30 分', title: '斜光仍可能持續', copy: '別急著離開；雲霧與山稜的層次常在日出後改變。', icon: 'sun' }
        ].map((step, index) => (
          <article class="paper-card reveal relative overflow-hidden p-6 sm:p-7">
            <span class="absolute right-5 top-4 font-serif text-6xl font-bold text-sand-200">0{index + 1}</span>
            <span class="grid size-11 place-items-center rounded-full bg-forest-900 text-sun-300"><Icon name={step.icon as any} /></span>
            <p class="mt-8 text-xs font-extrabold tracking-widest text-sun-500">{step.time}</p>
            <h3 class="mt-2 font-serif text-2xl font-bold">{step.title}</h3>
            <p class="mt-3 text-sm leading-7 text-forest-700">{step.copy}</p>
          </article>
        ))}
      </div>

      <div class="reveal mt-10 flex flex-col gap-5 rounded-3xl bg-forest-900 p-6 text-white sm:flex-row sm:items-center sm:justify-between sm:p-8">
        <div class="flex gap-4"><span class="grid size-11 shrink-0 place-items-center rounded-full bg-sun-400 text-forest-950"><Icon name="info" /></span><div><p class="font-extrabold">凌晨山路黑、彎道多，請降低車速</p><p class="mt-1 text-sm leading-6 text-white/60">不要把官方地址當成唯一導航依據，直接使用觀日平臺座標較清楚。</p></div></div>
