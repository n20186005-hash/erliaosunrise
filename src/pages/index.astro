---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConditionsPanel from '../components/ConditionsPanel.astro';
import Icon from '../components/Icon.astro';

const title = '二寮觀日亭日出攻略｜日出時間、即時影像、交通停車';
const description = '規劃台南二寮觀日亭日出行程：查看下一次日出時間、觀景條件、官方即時影像、導航、停車、拍攝提示與左鎮周邊路線。';

const faqs = [
  {
    question: '二寮觀日亭需要門票嗎？',
    answer: '目前官方景點資訊標示為免門票、全天開放。特殊活動、道路施工、天候或節慶交通管制仍可能影響通行，出發前應查看最新公告。'
  },
  {
    question: '應該在日出前多久抵達？',
    answer: '第一次前往建議在日出前 60 至 90 分鐘抵達。除了預留停車與步行時間，也能在天色漸亮時確認構圖；攝影旺季或連假則應再提早。'
  },
  {
    question: '什麼季節最容易看到二寮日出與雲海？',
    answer: '官方建議通常以 6 月至 9 月為較佳觀賞季節，雨後隔日也較可能出現晨霧與雲海，但這不是保證。雲層、濕度、風向與能見度都會影響結果。'
  },
  {
    question: '沒有開車也能前往嗎？',
    answer: '可以安排計程車或包車，但清晨大眾運輸通常難以配合日出時間。若搭公車到岡林一帶，仍須步行一段山路，應先核對最新班次與回程方式。'
  },
  {
    question: '現場有停車場與廁所嗎？',
    answer: '西拉雅國家風景區資料列有停車與廁所設施。實際可用狀態、容量與臨時交管可能改變，夜間行車及停車時請勿阻礙道路。'
  },
  {
    question: '二寮日出一定看得到嗎？',
    answer: '不一定。二寮最迷人的景觀來自陽光、山稜、低層雲霧與能見度同時配合。本站指數只能協助判斷，出發前仍應查看官方即時影像。'
  }
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TouristAttraction',
    name: '台南二寮觀日亭',
    alternateName: ['二寮日出', '二寮觀日平臺', 'Erliao Sunrise Pavilion'],
    description,
    url: 'https://erliaosunrise.com/',
    image: [
      'https://erliaosunrise.com/images/hero-erliao-sunrise.webp',
      'https://erliaosunrise.com/images/erliao-platform.webp',
      'https://erliaosunrise.com/images/erliao-mist.webp'
    ],
    isAccessibleForFree: true,
    openingHours: 'Mo-Su 00:00-23:59',
    geo: {
      '@type': 'GeoCoordinates',
      latitude: 22.9927444,
      longitude: 120.4098726
    },
    address: {
      '@type': 'PostalAddress',
      addressLocality: '左鎮區',
      addressRegion: '臺南市',
      addressCountry: 'TW'
    },
    touristType: ['攝影旅人', '自駕旅人', '自然景觀旅人'],
    sameAs: [
      'https://www.siraya-nsa.gov.tw/zh-tw/attractions/detail/30',
      'https://www.twtainan.net/zh-tw/attractions/detail/569/'
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer }
    }))
  }
];
---
<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/hero-erliao-sunrise.webp" fetchpriority="high" />
  </Fragment>

  <section class="grain relative min-h-[820px] overflow-hidden bg-forest-950 text-white sm:min-h-[850px]">
    <img
      class="absolute inset-0 h-full w-full object-cover object-[56%_48%]"
      src="/images/hero-erliao-sunrise.webp"
      alt="二寮清晨日出穿過山谷薄霧與竹林"
      width="1920"
      height="1280"
      fetchpriority="high"
    />
    <div class="hero-shade absolute inset-0"></div>

    <div class="site-container relative flex min-h-[820px] flex-col justify-center pb-36 pt-32 sm:min-h-[850px]">
      <div class="max-w-[45rem]">
        <div class="flex flex-wrap gap-2 text-xs font-extrabold tracking-wide">
          <span class="rounded-full border border-white/25 bg-white/10 px-3 py-1.5 backdrop-blur">臺南・左鎮</span>
          <span class="rounded-full border border-white/25 bg-white/10 px-3 py-1.5 backdrop-blur">全天開放・免門票</span>
          <span class="rounded-full border border-white/25 bg-white/10 px-3 py-1.5 backdrop-blur">低海拔雲海日出</span>
        </div>
        <h1 class="mt-7 max-w-[9ch] font-serif text-[clamp(3.5rem,10vw,7.3rem)] font-bold leading-[.96] tracking-[-.065em] text-white">天亮以前，先來二寮。</h1>
        <p class="mt-7 max-w-2xl text-base font-medium leading-8 text-white/72 sm:text-lg">在左鎮月世界的丘陵與竹林之上，等待第一道斜光穿過谷地晨霧。先看日出時間與現場條件，再決定今晚要不要出發。</p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a class="sun-button" href="#conditions"><Icon name="sunrise" size={19} />查看下一次日出</a>
          <a class="outline-button" href="#live"><Icon name="camera" size={18} />查看即時影像</a>
        </div>
      </div>

      <a class="absolute bottom-9 left-4 inline-flex items-center gap-3 text-sm font-bold text-white/58 transition hover:text-white sm:left-auto" href="#conditions">
        <span class="grid size-10 place-items-center rounded-full border border-white/25"><Icon name="arrowDown" size={17} /></span>
        往下規劃行程
      </a>
    </div>

    <div class="absolute inset-x-0 bottom-0 border-t border-white/15 bg-black/15 backdrop-blur-md">
      <div class="site-container grid grid-cols-2 divide-x divide-white/15 sm:grid-cols-4">
        <div class="px-3 py-5 sm:px-6"><p class="text-[.66rem] font-bold tracking-widest text-white/45">建議停留</p><p class="mt-1 font-serif text-xl font-bold">1–2 小時</p></div>
        <div class="px-3 py-5 sm:px-6"><p class="text-[.66rem] font-bold tracking-widest text-white/45">推薦季節</p><p class="mt-1 font-serif text-xl font-bold">6–9 月</p></div>
        <div class="hidden px-6 py-5 sm:block"><p class="text-[.66rem] font-bold tracking-widest text-white/45">座標</p><p class="mt-1 font-serif text-xl font-bold">22.9927°N</p></div>
        <div class="hidden px-6 py-5 sm:block"><p class="text-[.66rem] font-bold tracking-widest text-white/45">出發方式</p><p class="mt-1 font-serif text-xl font-bold">自駕優先</p></div>
      </div>
    </div>
  </section>

  <ConditionsPanel />

  <section id="live" class="bg-forest-950 py-20 text-white sm:py-28">
    <div class="site-container">
      <div class="reveal flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow"><Icon name="camera" size={16} /> 現場畫面</p>
          <h2 class="section-title text-white">先看此刻的二寮。</h2>
        </div>
        <p class="max-w-md text-sm leading-7 text-white/58">即時影像可能因天候、設備或網路狀況暫時中斷，畫面時間請以播放器顯示為準。</p>
      </div>
      <div class="reveal mt-10 overflow-hidden rounded-[2rem] border border-white/10 bg-black shadow-[0_32px_90px_rgba(0,0,0,.28)]">
        <div class="aspect-video">
          <iframe
            class="h-full w-full"
            src="https://www.youtube.com/embed/xbojeDKjcaM?mute=1&amp;autoplay=1&amp;playsinline=1"
            title="二寮觀日平臺即時影像"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="overflow-hidden bg-white py-20 sm:py-32">
    <div class="site-container grid items-center gap-12 lg:grid-cols-[1.05fr_.95fr] lg:gap-20">
      <div class="photo-frame reveal aspect-[4/3] lg:aspect-[5/6]">
        <img src="/images/erliao-mist.webp" alt="二寮山谷竹林間的金色晨霧" width="1280" height="853" loading="lazy" />
      </div>
      <div class="reveal">
        <p class="eyebrow"><Icon name="mountain" size={16} /> 最接近城市的曙光</p>
        <h2 class="section-title">不是只看太陽，而是等一幅山水畫醒來。</h2>
        <div class="mt-7 space-y-5 section-copy">
          <p>二寮的辨識度，來自月世界地形、竹林、山稜與谷底水氣。當晨光從東方切入，薄霧會把丘陵分成遠近不同的層次，形成攝影者熟悉的斜射光景觀。</p>
          <p>這裡海拔不高，不必攀登高山；代價是你仍要在深夜行車、在天亮前抵達，並接受每天景色都不同。沒有霧、雲太厚或風太強，都可能讓期待落空。</p>
        </div>
        <div class="mt-9 grid grid-cols-2 gap-4">
          <div class="paper-card p-5"><Icon name="sunrise" class="text-sun-500" /><p class="mt-4 font-extrabold">日出與斜射光</p><p class="mt-2 text-sm leading-6 text-forest-700">太陽越過山稜後，光線穿過晨霧與竹林。</p></div>
          <div class="paper-card p-5"><Icon name="cloud" class="text-sun-500" /><p class="mt-4 font-extrabold">低層雲霧</p><p class="mt-2 text-sm leading-6 text-forest-700">雨後、水氣與微風配合時，谷地更有層次。</p></div>
        </div>
      </div>
    </div>
  </section>

  <section id="guide" class="bg-sand-100 py-20 sm:py-32">
    <div class="site-container">
      <div class="reveal max-w-3xl">
        <p class="eyebrow"><Icon name="clock" size={16} /> 第一次前往</p>
        <h2 class="section-title">把抵達時間，倒著安排。</h2>
        <p class="section-copy mt-6">二寮不是到了才開始看。從黑暗、藍調到第一道金光，整段清晨都值得保留。以下時間以當日日出為基準，不是固定鐘點。</p>
      </div>

      <div class="mt-14 grid gap-5 lg:grid-cols-4">
        {[
          { time: '日出前 90 分', title: '抵達停車', copy: '旺季更早。留時間熟悉入口、如廁與確認回程道路。', icon: 'car' },
          { time: '日出前 60 分', title: '找到觀景位置', copy: '使用頭燈，避免用強光直照他人與攝影器材。', icon: 'mapPin' },
          { time: '日出前 30 分', title: '天色開始轉變', copy: '先觀察東方雲層與谷底霧氣，不必只盯著太陽。', icon: 'cloud' },
          { time: '日出後 30 分', title: '斜光仍可能持續', copy: '別急著離開；雲霧與山稜的層次常在日出後改變。', icon: 'sun' }
        ].map((step, index) => (
          <article class="paper-card reveal relative overflow-hidden p-6 sm:p-7">
            <span class="absolute right-5 top-4 font-serif text-6xl font-bold text-sand-200">0{index + 1}</span>
            <span class="grid size-11 place-items-center rounded-full bg-forest-900 text-sun-300"><Icon name={step.icon as any} /></span>
            <p class="mt-8 text-xs font-extrabold tracking-widest text-sun-500">{step.time}</p>
            <h3 class="mt-2 font-serif text-2xl font-bold">{step.title}</h3>
            <p class="mt-3 text-sm leading-7 text-forest-700">{step.copy}</p>
          </article>
        ))}
      </div>

      <div class="reveal mt-10 flex flex-col gap-5 rounded-3xl bg-forest-900 p-6 text-white sm:flex-row sm:items-center sm:justify-between sm:p-8">
        <div class="flex gap-4"><span class="grid size-11 shrink-0 place-items-center rounded-full bg-sun-400 text-forest-950"><Icon name="info" /></span><div><p class="font-extrabold">凌晨山路黑、彎道多，請降低車速</p><p class="mt-1 text-sm leading-6 text-white/60">不要把官方地址當成唯一導航依據，直接使用觀日平臺座標較清楚。</p></div></div>
        <a class="sun-button shrink-0" href="https://www.google.com/maps/dir/?api=1&destination=22.9927444%2C120.4098726&travelmode=driving" target="_blank" rel="noopener noreferrer"><Icon name="route" size={18} />導航至觀日平臺</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20 sm:py-32">
    <div class="site-container">
      <div class="reveal flex flex-col gap-7 sm:flex-row sm:items-end sm:justify-between">
        <div><p class="eyebrow"><Icon name="camera" size={16} /> 真實景色</p><h2 class="section-title">二寮的每一個清晨，都不會複製。</h2></div>
        <p class="max-w-md text-sm leading-7 text-forest-700">下列照片均為二寮實景，採用 Wikimedia Commons 開放授權作品，完整作者與授權資訊請見照片來源頁。</p>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-12 md:grid-rows-[260px_280px]">
        <figure class="photo-frame reveal relative md:col-span-7 md:row-span-2">
          <img src="/images/erliao-sunrise.webp" alt="二寮日出升起於山稜與雲霧之上" width="1440" height="1080" loading="lazy" />
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent px-5 pb-5 pt-14 text-xs text-white/75">日出、山稜與低層晨霧</figcaption>
        </figure>
        <figure class="photo-frame reveal relative md:col-span-5">
          <img src="/images/erliao-platform.webp" alt="空拍視角下的二寮觀日平臺、道路與月世界丘陵" width="960" height="539" loading="lazy" />
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent px-5 pb-5 pt-14 text-xs text-white/75">觀日平臺與周邊丘陵</figcaption>
        </figure>
        <figure class="photo-frame reveal relative md:col-span-5">
          <img src="/images/erliao-mist.webp" alt="晨光灑在二寮竹林與霧氣間" width="1280" height="853" loading="lazy" />
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent px-5 pb-5 pt-14 text-xs text-white/75">晨光穿過竹林霧氣</figcaption>
        </figure>
      </div>
      <div class="mt-6 text-right"><a class="inline-flex items-center gap-1 text-sm font-bold text-forest-700 underline decoration-sand-200 underline-offset-4 hover:text-forest-950" href="/credits/">查看作者與照片授權 <Icon name="chevron" size={15} /></a></div>
    </div>
  </section>

  <section id="transport" class="bg-forest-950 py-20 text-white sm:py-32">
    <div class="site-container">
      <div class="grid gap-12 lg:grid-cols-[.9fr_1.1fr] lg:gap-20">
        <div class="reveal">
          <p class="eyebrow"><Icon name="route" size={16} /> 交通與停車</p>
          <h2 class="section-title text-white">清晨抵達，最好把路線準備在前一晚。</h2>
          <p class="mt-6 text-base leading-8 text-white/62">二寮位在臺南左鎮山區。為了配合日出，自駕、計程車或包車最實際；大眾運輸通常難以在日出前抵達，且下車後仍可能需要步行。</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a class="sun-button" href="https://www.google.com/maps/dir/?api=1&destination=22.9927444%2C120.4098726&travelmode=driving" target="_blank" rel="noopener noreferrer"><Icon name="mapPin" size={18} />Google Maps 導航</a>
            <button id="copy-coordinates" type="button" class="outline-button"><Icon name="mapPin" size={18} />複製座標</button>
          </div>
          <p id="copy-feedback" class="mt-3 min-h-5 text-xs text-sun-300" aria-live="polite"></p>
        </div>

        <div class="space-y-4">
          {[
            { icon: 'car', title: '自駕前往', copy: '建議直接導航至 22.9927444, 120.4098726。夜間道路照明有限，彎道與會車處請減速。' },
            { icon: 'mapPin', title: '停車與步行', copy: '官方資料列有停車場與廁所，但容量、開放狀態與節慶交管可能變動。請依現場指示停放。' },
            { icon: 'clock', title: '大眾運輸', copy: '公車班次通常不適合追日出；若從岡林一帶步行，需預留山路時間並先確認回程。' },
            { icon: 'shield', title: '特殊交管', copy: '元旦、活動或道路施工期間可能實施管制。出發前查看西拉雅與臺南市最新公告。' }
          ].map((item) => (
            <article class="reveal flex gap-5 rounded-3xl border border-white/10 bg-white/[.055] p-6 sm:p-7">
              <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-white/10 text-sun-300"><Icon name={item.icon as any} /></span>
              <div><h3 class="font-serif text-xl font-bold">{item.title}</h3><p class="mt-2 text-sm leading-7 text-white/58">{item.copy}</p></div>
            </article>
          ))}
        </div>
      </div>

      <div class="reveal mt-12 overflow-hidden rounded-[2rem] border border-white/10 bg-white/[.055] p-2 shadow-[0_28px_80px_rgba(0,0,0,.22)] sm:p-3">
        <iframe
          class="h-[360px] w-full rounded-[1.5rem] sm:h-[480px]"
          src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d14691.080727905046!2d120.41088!3d22.995477!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x346e6f15d5ea73f9%3A0xaab02ee62f7e6d0f!2z5Y-w5Y2X5LqM5a-u6KeA5pel5Lqt!5e0!3m2!1szh-TW!2sus!4v1785305918538!5m2!1szh-TW!2sus"
          title="台南二寮觀日亭地圖"
          allowfullscreen
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>
    </div>
  </section>

  <section id="photography" class="bg-sand-50 py-20 sm:py-32">
    <div class="site-container grid gap-12 lg:grid-cols-[1.02fr_.98fr] lg:items-center lg:gap-20">
      <div class="reveal order-2 lg:order-1">
        <p class="eyebrow"><Icon name="aperture" size={16} /> 攝影提示</p>
        <h2 class="section-title">先拍光，再拍太陽。</h2>
        <p class="section-copy mt-6">二寮的主角往往不是太陽本身，而是陽光穿過雲霧後，在竹林與山谷留下的明暗層次。構圖時多看前景與霧帶，照片會更有空間感。</p>
        <div class="mt-9 grid gap-4 sm:grid-cols-2">
          {[
            ['廣角 16–35mm', '保留天空、山谷與環境，適合拍攝完整晨景。'],
            ['中長焦 70–200mm', '壓縮山稜與霧層，捕捉局部斜射光。'],
            ['三腳架與快門線', '藍調時段光線不足，也可使用相機延時自拍。'],
            ['手機拍攝', '點按亮部降低曝光，避免太陽與霧氣全部過曝。']
          ].map(([name, copy]) => (
            <div class="paper-card p-5"><p class="font-extrabold">{name}</p><p class="mt-2 text-sm leading-6 text-forest-700">{copy}</p></div>
          ))}
        </div>
        <p class="mt-7 flex items-start gap-2 text-sm leading-7 text-forest-700"><Icon name="info" size={17} class="mt-1 shrink-0 text-sun-500" />請保持通道暢通，不跨越護欄、不使用強光干擾他人；空拍與特殊器材須另行核對當日法規及現場限制。</p>
      </div>
      <div class="photo-frame reveal order-1 aspect-[4/5] lg:order-2">
        <img src="/images/hero-erliao-sunrise.webp" alt="二寮日出斜射光照亮竹林與晨霧" width="1920" height="1280" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="bg-white py-20 sm:py-28">
    <div class="site-container">
