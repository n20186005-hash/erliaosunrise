    const feedback = document.querySelector<HTMLElement>('#copy-feedback');
    copyButton?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('22.9927444, 120.4098726');
        if (feedback) feedback.textContent = '已複製座標：22.9927444, 120.4098726';
