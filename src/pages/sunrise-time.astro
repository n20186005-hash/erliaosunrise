---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import TopicLinks from '../components/TopicLinks.astro';
import { nextSunrises } from '../lib/sunrise';

const title = '二寮觀日亭日出時間｜未來 14 天與建議抵達';
const description = '台南二寮觀日亭未來 14 天日出時間總表，含每日天文日出時刻、建議抵達時間與時區說明，出發追光前一次掌握。';

const sunrises = nextSunrises(14);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: '二寮觀日亭日出時間',
    url: 'https://erliaosunrise.com/sunrise-time/',
    isPartOf: { '@type': 'WebSite', name: '二寮日出指南', url: 'https://erliaosunrise.com/' },
    about: { '@type': 'TouristAttraction', name: '台南二寮觀日亭' }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://erliaosunrise.com/' },
      { '@type': 'ListItem', position: 2, name: '二寮觀日亭日出時間', item: 'https://erliaosunrise.com/sunrise-time/' }
    ]
  }
];
---
<BaseLayout title={title} description={description} canonical="/sunrise-time/" jsonLd={jsonLd}>
  <section class="bg-forest-950 pb-16 pt-32 text-white sm:pb-24 sm:pt-40">
    <div class="site-container">
      <nav aria-label="麵包屑" class="flex flex-wrap items-center gap-2 text-sm font-bold text-white/55">
        <a href="/" class="hover:text-white">首頁</a>
        <span class="text-sun-400" aria-hidden="true">→</span>
        <span class="text-white">日出時間</span>
      </nav>
      <p class="eyebrow mt-6"><Icon name="sunrise" size={16} /> 日出時間</p>
      <h1 class="mt-5 max-w-[15ch] font-serif text-[clamp(2.4rem,7vw,5rem)] font-bold leading-[1.05] tracking-[-.05em]">二寮觀日亭，未來 14 天日出。</h1>
      <p class="mt-7 max-w-2xl text-base leading-8 text-white/62">這份日出時刻依二寮觀日亭座標（22.9927°N, 120.4099°E）計算，時區 UTC+8。數值為天文日出概估值，山稜遮擋可能使現場可見太陽的時間略晚；實際出發前請再以官方日出日沒時刻與即時影像確認。</p>
    </div>
  </section>

  <section class="bg-sand-50 py-16 sm:py-24">
    <div class="site-container">
      <div class="overflow-hidden rounded-3xl border border-sand-200 bg-white">
        <div class="grid grid-cols-[1.4fr_1fr_1fr] gap-px bg-sand-200 text-sm font-extrabold text-forest-800">
          <div class="bg-white px-5 py-4">日期</div>
          <div class="bg-white px-5 py-4 text-center">日出時間</div>
          <div class="bg-white px-5 py-4 text-center">建議抵達</div>
        </div>
        {sunrises.map((day) => (
          <div class="grid grid-cols-[1.4fr_1fr_1fr] gap-px border-t border-sand-200 bg-sand-200 text-sm">
            <div class="bg-white px-5 py-4">
              <p class="font-bold text-forest-900">{day.label}</p>
              <p class="text-xs text-forest-700/60">{day.dateLabel}</p>
            </div>
            <div class="bg-white px-5 py-4 text-center font-serif text-xl font-bold text-forest-900">{day.time}</div>
            <div class="bg-white px-5 py-4 text-center font-serif text-xl font-bold text-sun-500">
              {day.time.slice(0, 2) === '00' || day.time.slice(0, 2) === '01'
                ? `${String((Number(day.time.slice(0, 2)) + 24 - 1) % 24).padStart(2, '0')}:${day.time.slice(3)}`
                : `${String(Number(day.time.slice(0, 2)) - 1).padStart(2, '0')}:${day.time.slice(3)}`}
            </div>
          </div>
        ))}
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        <div class="paper-card p-6">
          <span class="grid size-11 place-items-center rounded-2xl bg-forest-900 text-sun-300"><Icon name="clock" size={20} /></span>
          <h2 class="mt-4 font-serif text-xl font-bold">怎麼看這張表</h2>
          <p class="mt-3 text-sm leading-7 text-forest-700">「建議抵達」為日出前 60 分鐘。第一次前往可再提早至 90 分鐘，預留停車、步行與天色適應時間。</p>
        </div>
        <div class="paper-card p-6">
          <span class="grid size-11 place-items-center rounded-2xl bg-forest-900 text-sun-300"><Icon name="mountain" size={20} /></span>
          <h2 class="mt-4 font-serif text-xl font-bold">為什麼是概估值</h2>
          <p class="mt-3 text-sm leading-7 text-forest-700">二寮位於月世界丘陵，東方山稜會遮擋地平線。表列時間為天文日出，現場看見太陽可能晚 5–15 分鐘，請保留緩衝。</p>
        </div>
        <div class="paper-card p-6">
          <span class="grid size-11 place-items-center rounded-2xl bg-forest-900 text-sun-300"><Icon name="sun" size={20} /></span>
          <h2 class="mt-4 font-serif text-xl font-bold">季節差異</h2>
          <p class="mt-3 text-sm leading-7 text-forest-700">夏季日出約 05:10–05:30，冬季約 06:30–06:50。表內已自動依當日計算，不需手動對照季節。</p>
        </div>
      </div>

      <p class="mt-8 max-w-2xl rounded-2xl bg-forest-900/5 p-5 text-sm leading-7 text-forest-700">本站為第三方旅遊資訊網站，非官方單位。日出時間僅供行程規劃參考，不代表一定能看到日出、雲海或斜射光；山區天氣可能快速變化，請以現場與主管機關公告為準。</p>
    </div>
  </section>

  <TopicLinks current="sunrise-time" />
</BaseLayout>
