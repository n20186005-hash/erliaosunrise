---
import Icon from './Icon.astro';
---
<div id="hero-sunrise" class="mt-8 max-w-[34rem] overflow-hidden rounded-[1.75rem] border border-white/20 bg-white/10 backdrop-blur-md sm:mt-9">
  <div class="grid grid-cols-3 divide-x divide-white/15">
    <div class="px-4 py-4">
      <p class="flex items-center gap-1.5 text-[.66rem] font-bold tracking-widest text-white/55"><Icon name="sunrise" size={13} />今日日出</p>
      <p class="mt-2 font-serif text-[1.4rem] font-bold leading-none sm:text-2xl" data-hero-sunrise="today">--:--</p>
      <p class="mt-1.5 text-[.68rem] font-medium text-white/40" data-hero-sunrise-date="today"></p>
    </div>
    <div class="px-4 py-4">
      <p class="flex items-center gap-1.5 text-[.66rem] font-bold tracking-widest text-white/55"><Icon name="sunrise" size={13} />明日日出</p>
      <p class="mt-2 font-serif text-[1.4rem] font-bold leading-none sm:text-2xl" data-hero-sunrise="tomorrow">--:--</p>
      <p class="mt-1.5 text-[.68rem] font-medium text-white/40" data-hero-sunrise-date="tomorrow"></p>
    </div>
    <div class="px-4 py-4">
      <p class="flex items-center gap-1.5 text-[.66rem] font-bold tracking-widest text-white/55"><Icon name="clock" size={13} />建議抵達</p>
      <p class="mt-2 font-serif text-[1.4rem] font-bold leading-none text-sun-300 sm:text-2xl" data-hero-arrive>--:--</p>
      <p class="mt-1.5 text-[.68rem] font-medium text-white/40">下一次日出前 60 分</p>
    </div>
  </div>
  <p class="border-t border-white/15 bg-black/15 px-4 py-2.5 text-[.66rem] leading-5 text-white/50">每日日出時間皆不同，以上依二寮觀日亭座標（22.9927°N, 120.4099°E）於你的瀏覽器即時計算，時區 UTC+8。</p>
</div>

<script>
  const LAT = 22.9927444;
  const LON = 120.4098726;
  const TZ = 8;
  const RAD = Math.PI / 180;
  const ZENITH = 90.833;

  const taipeiDate = (offsetDays = 0) => {
    const parts = new Intl.DateTimeFormat('en-CA', {
      timeZone: 'Asia/Taipei',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit'
    }).formatToParts(new Date(Date.now() + offsetDays * 86400000));
    const read = (type: string) => Number(parts.find((part) => part.type === type)?.value);
    return { year: read('year'), month: read('month'), day: read('day') };
  };

  const weekdayLabel = (offsetDays = 0) => new Intl.DateTimeFormat('zh-TW', {
    timeZone: 'Asia/Taipei',
    month: 'numeric',
    day: 'numeric',
    weekday: 'short'
  }).format(new Date(Date.now() + offsetDays * 86400000));

  const sunriseHours = (year: number, month: number, day: number): number | null => {
    const dayOfYear = Math.floor((Date.UTC(year, month - 1, day) - Date.UTC(year, 0, 0)) / 86400000);
    const lngHour = LON / 15;
    const t = dayOfYear + (6 - lngHour) / 24;

    const meanAnomaly = 0.9856 * t - 3.289;
    let trueLongitude = meanAnomaly
      + 1.916 * Math.sin(meanAnomaly * RAD)
      + 0.02 * Math.sin(2 * meanAnomaly * RAD)
      + 282.634;
    trueLongitude = ((trueLongitude % 360) + 360) % 360;

    let rightAscension = Math.atan(0.91764 * Math.tan(trueLongitude * RAD)) / RAD;
    rightAscension = ((rightAscension % 360) + 360) % 360;
    rightAscension += Math.floor(trueLongitude / 90) * 90 - Math.floor(rightAscension / 90) * 90;
    rightAscension /= 15;

    const sinDeclination = 0.39782 * Math.sin(trueLongitude * RAD);
    const cosDeclination = Math.cos(Math.asin(sinDeclination));
    const cosHourAngle = (Math.cos(ZENITH * RAD) - sinDeclination * Math.sin(LAT * RAD))
      / (cosDeclination * Math.cos(LAT * RAD));
    if (cosHourAngle > 1 || cosHourAngle < -1) return null;

    const hourAngle = (360 - Math.acos(cosHourAngle) / RAD) / 15;
    const utcHours = hourAngle + rightAscension - 0.06571 * t - 6.622 - lngHour;
    return ((((utcHours % 24) + 24) % 24) + TZ) % 24;
  };

  const formatHours = (hours: number) => {
    const total = Math.round(hours * 60);
    return `${String(Math.floor(total / 60) % 24).padStart(2, '0')}:${String(total % 60).padStart(2, '0')}`;
  };

  const root = document.querySelector<HTMLElement>('#hero-sunrise');
  if (root) {
    const todayDate = taipeiDate(0);
    const tomorrowDate = taipeiDate(1);
    const todaySunrise = sunriseHours(todayDate.year, todayDate.month, todayDate.day);
    const tomorrowSunrise = sunriseHours(tomorrowDate.year, tomorrowDate.month, tomorrowDate.day);

    const setText = (selector: string, value: string) => {
      const node = root?.querySelector<HTMLElement>(selector);
      if (node) node.textContent = value;
    };

    if (todaySunrise !== null) {
      setText('[data-hero-sunrise="today"]', formatHours(todaySunrise));
      setText('[data-hero-sunrise-date="today"]', weekdayLabel(0));
    }
    if (tomorrowSunrise !== null) {
      setText('[data-hero-sunrise="tomorrow"]', formatHours(tomorrowSunrise));
      setText('[data-hero-sunrise-date="tomorrow"]', weekdayLabel(1));
    }

    const nowHours = (Date.now() / 3600000 + TZ) % 24;
    const nextSunrise = todaySunrise !== null && todaySunrise > nowHours ? todaySunrise : tomorrowSunrise;
    if (nextSunrise !== null) setText('[data-hero-arrive]', formatHours(nextSunrise - 1));
  }
</script>
