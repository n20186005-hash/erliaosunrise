---
import Icon from './Icon.astro';
import { nextSunrises, formatHours, sunriseHours, taipeiDate } from '../lib/sunrise';

// 建置期（伺服器）預先計算今日／明日日出與建議抵達，讓搜尋引擎與未執行 JS 的環境也能讀到實際時間。
// 瀏覽器載入後會以當下日期重新計算，確保即時正確。
const days = nextSunrises(2);
const today = days[0];
const tomorrow = days[1];
const todayDate = taipeiDate(0);
const todayHours = sunriseHours(todayDate.year, todayDate.month, todayDate.day);
const arrive = todayHours !== null ? formatHours(todayHours - 1) : '--:--';
---
<div id="hero-sunrise" class="mt-8 max-w-[34rem] overflow-hidden rounded-[1.75rem] border border-white/20 bg-white/10 backdrop-blur-md sm:mt-9">
  <div class="grid grid-cols-3 divide-x divide-white/15">
    <div class="px-4 py-4">
      <p class="flex items-center gap-1.5 text-[.66rem] font-bold tracking-widest text-white/55"><Icon name="sunrise" size={13} />今日日出</p>
      <p class="mt-2 font-serif text-[1.4rem] font-bold leading-none sm:text-2xl" data-hero-sunrise="today">{today?.time ?? '--:--'}</p>
      <p class="mt-1.5 text-[.68rem] font-medium text-white/40" data-hero-sunrise-date="today">{today?.label}</p>
    </div>
    <div class="px-4 py-4">
      <p class="flex items-center gap-1.5 text-[.66rem] font-bold tracking-widest text-white/55"><Icon name="sunrise" size={13} />明日日出</p>
      <p class="mt-2 font-serif text-[1.4rem] font-bold leading-none sm:text-2xl" data-hero-sunrise="tomorrow">{tomorrow?.time ?? '--:--'}</p>
      <p class="mt-1.5 text-[.68rem] font-medium text-white/40" data-hero-sunrise-date="tomorrow">{tomorrow?.label}</p>
    </div>
    <div class="px-4 py-4">
      <p class="flex items-center gap-1.5 text-[.66rem] font-bold tracking-widest text-white/55"><Icon name="clock" size={13} />建議抵達</p>
      <p class="mt-2 font-serif text-[1.4rem] font-bold leading-none text-sun-300 sm:text-2xl" data-hero-arrive>{arrive}</p>
      <p class="mt-1.5 text-[.68rem] font-medium text-white/40">下一次日出前 60 分</p>
    </div>
  </div>
  <p class="border-t border-white/15 bg-black/15 px-4 py-2.5 text-[.66rem] leading-5 text-white/50">每日日出時間皆不同，以上依二寮觀日亭座標（22.9927°N, 120.4099°E）計算，時區 UTC+8；山稜遮擋可能使現場可見太陽的時間略晚於天文日出。</p>
</div>

<script>
  import { nextSunrises, formatHours, sunriseHours, taipeiDate } from '../lib/sunrise';

  const root = document.querySelector<HTMLElement>('#hero-sunrise');
  if (root) {
    const days = nextSunrises(2);
    const today = days[0];
    const tomorrow = days[1];

    const setText = (selector: string, value: string) => {
      const node = root.querySelector<HTMLElement>(selector);
      if (node) node.textContent = value;
    };

    if (today) {
      setText('[data-hero-sunrise="today"]', today.time);
      setText('[data-hero-sunrise-date="today"]', today.label);
    }
    if (tomorrow) {
      setText('[data-hero-sunrise="tomorrow"]', tomorrow.time);
      setText('[data-hero-sunrise-date="tomorrow"]', tomorrow.label);
    }

    // 建議抵達 = 下一次日出前 60 分鐘。
    const nowHours = (Date.now() / 3600000 + 8) % 24;
    const todayDate = taipeiDate(0);
    const todayHours = sunriseHours(todayDate.year, todayDate.month, todayDate.day);
    const nextHours = todayHours !== null && todayHours > nowHours
      ? todayHours
      : (() => {
          const d = taipeiDate(1);
          return sunriseHours(d.year, d.month, d.day);
        })();
    if (nextHours !== null) setText('[data-hero-arrive]', formatHours(nextHours - 1));
  }
</script>
