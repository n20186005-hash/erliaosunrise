---
import Icon from './Icon.astro';
---
<section id="conditions" class="relative bg-sand-50 py-20 sm:py-28">
  <div class="site-container">
    <div class="grid items-end gap-8 lg:grid-cols-[.82fr_1.18fr]">
      <div class="reveal">
        <p class="eyebrow"><Icon name="cloud" size={16} /> 出發決策</p>
        <h2 class="section-title">下一次日出，值得出發嗎？</h2>
      </div>
      <div class="reveal flex flex-wrap gap-3 lg:justify-end">
        <a class="inline-flex min-h-12 items-center gap-2 rounded-full border border-forest-900/15 bg-white px-5 font-extrabold text-forest-900 transition hover:-translate-y-0.5 hover:border-forest-900/35" href="#live">
          <span class="relative flex size-2.5"><span class="absolute inline-flex size-full animate-ping rounded-full bg-red-400 opacity-75"></span><span class="relative inline-flex size-2.5 rounded-full bg-red-500"></span></span>
          查看即時影像
          <Icon name="chevron" size={16} />
        </a>
      </div>
    </div>

    <div id="conditions-card" class="mt-12 overflow-hidden rounded-[2rem] bg-forest-950 text-white shadow-[0_32px_90px_rgba(16,32,28,.18)]" aria-live="polite" aria-busy="true">
      <div data-weather-loading class="grid min-h-96 place-items-center px-7 py-16 text-center">
        <div>
          <span class="mx-auto block size-12 animate-spin rounded-full border-2 border-white/15 border-t-sun-300" aria-hidden="true"></span>
          <p class="mt-5 font-serif text-2xl font-bold">正在取得最新天氣</p>
          <p class="mt-2 text-sm text-white/50">請稍候，預報很快就會出現。</p>
        </div>
      </div>

      <div data-weather-content hidden>
        <div class="flex flex-col gap-5 border-b border-white/10 bg-white/[.04] px-7 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-9">
          <div class="flex items-center gap-4">
            <span data-current-icon class="text-4xl" aria-hidden="true">🌤️</span>
            <div>
              <p class="text-xs font-bold tracking-[.14em] text-white/40">二寮目前天氣</p>
              <p class="mt-1 font-serif text-2xl font-bold"><span data-current-condition>--</span> · <span data-current-temperature>--°</span></p>
            </div>
          </div>
          <div class="grid grid-cols-3 gap-x-6 gap-y-2 text-sm">
            <p><span class="text-white/40">體感</span> <strong data-current-apparent>--°</strong></p>
            <p><span class="text-white/40">濕度</span> <strong data-current-humidity>--%</strong></p>
            <p><span class="text-white/40">陣風</span> <strong data-current-gust>-- km/h</strong></p>
          </div>
        </div>

        <div class="grid lg:grid-cols-[.78fr_1.22fr]">
          <div class="relative overflow-hidden border-b border-white/10 p-7 sm:p-9 lg:border-b-0 lg:border-r">
            <div class="absolute -right-20 -top-24 size-64 rounded-full bg-sun-400/10 blur-3xl"></div>
            <div class="relative">
              <div class="flex items-start justify-between gap-5">
                <div>
                  <p data-target-date class="text-sm font-bold text-sun-300">下一次日出</p>
                  <p class="mt-3 font-serif text-3xl font-bold sm:text-4xl" data-recommendation-title>觀景條件</p>
                </div>
                <div data-score-ring class="grid size-24 shrink-0 place-items-center rounded-full" style="background: conic-gradient(#eeb55a 0deg, rgba(255,255,255,.1) 0deg)">
                  <div class="grid size-[4.7rem] place-items-center rounded-full bg-forest-950 text-center">
                    <span data-score class="text-2xl font-black">0</span>
                    <span class="-mt-3 text-[.62rem] font-bold tracking-widest text-white/45">指數</span>
                  </div>
                </div>
              </div>
              <p data-recommendation-summary class="mt-5 max-w-md text-sm leading-7 text-white/60"></p>

              <div class="mt-8 grid grid-cols-3 gap-3">
                <div class="rounded-2xl bg-white/[.07] p-4">
                  <p class="text-xs text-white/45">日出</p>
                  <p data-sunrise class="mt-1 text-xl font-black"></p>
                </div>
                <div class="rounded-2xl bg-white/[.07] p-4">
                  <p class="text-xs text-white/45">天光</p>
                  <p data-dawn class="mt-1 text-xl font-black"></p>
                </div>
                <div class="rounded-2xl bg-sun-400 p-4 text-forest-950">
                  <p class="text-xs font-bold opacity-60">建議抵達</p>
                  <p data-arrive class="mt-1 text-xl font-black"></p>
                </div>
              </div>
            </div>
          </div>

          <div class="p-7 sm:p-9">
            <div class="flex items-center justify-between gap-4">
              <div>
                <p class="text-xs font-bold tracking-[.14em] text-white/40">日出時段預報</p>
                <p class="mt-1 font-serif text-2xl font-bold"><span data-target-icon aria-hidden="true">🌤️</span> <span data-target-condition>--</span></p>
              </div>
              <p data-updated class="text-right text-xs text-white/40"></p>
            </div>

            <dl class="mt-7 grid grid-cols-2 gap-x-6 gap-y-7 sm:grid-cols-3">
              <div class="flex gap-3">
                <Icon name="cloud" class="mt-0.5 text-sun-300" />
                <div><dt class="text-xs text-white/45">清晨雲量</dt><dd class="mt-1 text-lg font-extrabold"><span data-cloud></span><span class="text-sm text-white/45">%</span></dd></div>
              </div>
              <div class="flex gap-3">
                <Icon name="droplet" class="mt-0.5 text-sun-300" />
                <div><dt class="text-xs text-white/45">相對濕度</dt><dd class="mt-1 text-lg font-extrabold"><span data-humidity></span><span class="text-sm text-white/45">%</span></dd></div>
              </div>
              <div class="flex gap-3">
                <Icon name="wind" class="mt-0.5 text-sun-300" />
                <div><dt class="text-xs text-white/45">風速</dt><dd class="mt-1 text-lg font-extrabold"><span data-wind></span><span class="text-sm text-white/45"> km/h</span></dd></div>
              </div>
              <div class="flex gap-3">
                <Icon name="mountain" class="mt-0.5 text-sun-300" />
                <div><dt class="text-xs text-white/45">能見度</dt><dd class="mt-1 text-lg font-extrabold"><span data-visibility></span><span class="text-sm text-white/45"> km</span></dd></div>
              </div>
              <div class="flex gap-3">
                <Icon name="droplet" class="mt-0.5 text-sun-300" />
                <div><dt class="text-xs text-white/45">降雨機率</dt><dd class="mt-1 text-lg font-extrabold"><span data-rain></span><span class="text-sm text-white/45">%</span></dd></div>
              </div>
              <div class="flex gap-3">
                <Icon name="sun" class="mt-0.5 text-sun-300" />
                <div><dt class="text-xs text-white/45">清晨氣溫</dt><dd class="mt-1 text-lg font-extrabold"><span data-temperature></span><span class="text-sm text-white/45">°C</span></dd></div>
              </div>
            </dl>

            <div data-advice class="mt-8 rounded-2xl bg-white/[.05] p-5 sm:p-6" hidden>
              <p class="flex items-center gap-2 text-sm font-extrabold text-sun-300"><Icon name="route" size={16} /> 智慧出行建議</p>
              <p class="mt-1.5 text-xs leading-5 text-white/40">依下一次日出時段的天氣自動生成，僅供行程參考。</p>
              <ul data-advice-risks hidden class="mt-4 space-y-2"></ul>
              <div class="mt-4 grid gap-5 sm:grid-cols-3">
                <div data-advice-group="outfit" hidden>
                  <p class="text-xs font-extrabold tracking-[.14em] text-white/45">出行穿搭</p>
                  <ul data-advice-list="outfit" class="mt-2.5 space-y-2 text-sm leading-6 text-white/75"></ul>
                </div>
                <div data-advice-group="activity" hidden>
                  <p class="text-xs font-extrabold tracking-[.14em] text-white/45">遊玩安排</p>
                  <ul data-advice-list="activity" class="mt-2.5 space-y-2 text-sm leading-6 text-white/75"></ul>
                </div>
                <div data-advice-group="gear" hidden>
                  <p class="text-xs font-extrabold tracking-[.14em] text-white/45">隨身物品</p>
                  <ul data-advice-list="gear" class="mt-2.5 space-y-2 text-sm leading-6 text-white/75"></ul>
                </div>
              </div>
            </div>

            <div class="mt-8 border-t border-white/10 pt-6">
              <p class="text-sm font-extrabold">未來一週預報</p>
              <div data-forecast class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-7"></div>
            </div>
          </div>
        </div>

        <div class="flex flex-col gap-2 border-t border-white/10 bg-black/10 px-7 py-4 text-xs leading-6 text-white/45 sm:flex-row sm:items-start sm:justify-between sm:px-9">
          <p class="flex items-start gap-2"><Icon name="info" size={15} class="mt-1 shrink-0" /><span data-disclaimer></span></p>
          <p class="shrink-0">資料來源：<a data-source class="font-bold text-white/65 underline decoration-white/25 underline-offset-4" href="https://open-meteo.com/" target="_blank" rel="noopener noreferrer">Open-Meteo</a></p>
        </div>
      </div>

      <div data-weather-error hidden class="grid min-h-96 place-items-center px-7 py-16 text-center">
        <div class="max-w-md">
          <span class="mx-auto grid size-14 place-items-center rounded-full bg-white/[.07] text-sun-300"><Icon name="info" size={26} /></span>
          <p class="mt-5 font-serif text-2xl font-bold">暫時無法取得天氣資料</p>
          <p class="mt-3 text-sm leading-7 text-white/55">請稍後再試，或先查看官方即時影像確認現場狀況。</p>
          <button data-weather-retry type="button" class="mt-6 min-h-11 rounded-full bg-sun-400 px-6 text-sm font-extrabold text-forest-950 transition hover:-translate-y-0.5">重新取得資料</button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  interface ForecastDay {
    label: string;
    sunrise: string;
    condition: string;
    icon: string;
    minTemperature: number;
    maxTemperature: number;
    precipitationProbability: number;
  }

  interface ConditionsAdvice {
    outfit: string[];
    activity: string[];
    gear: string[];
    risks: string[];
  }

  interface ConditionsPayload {
    status: 'ok';
    updatedAt: string;
    current: {
      temperature: number;
      apparentTemperature: number;
      humidity: number;
      windGust: number;
      condition: string;
      icon: string;
    };
    target: {
      dateLabel: string;
      sunrise: string;
      civilDawn: string;
      arriveBy: string;
    };
    weather: {
      cloudCover: number;
      humidity: number;
      windSpeed: number;
      visibilityKm: number;
      precipitationProbability: number;
      temperature: number;
      condition: string;
      icon: string;
    };
    recommendation: {
      score: number;
      title: string;
      summary: string;
      level: string;
    };
    advice?: ConditionsAdvice;
    forecast: ForecastDay[];
    source: {
      name: string;
      url: string;
    };
    disclaimer: string;
  }

  const card = document.querySelector<HTMLElement>('#conditions-card');
  const loading = card?.querySelector<HTMLElement>('[data-weather-loading]');
  const content = card?.querySelector<HTMLElement>('[data-weather-content]');
  const error = card?.querySelector<HTMLElement>('[data-weather-error]');
  const retry = card?.querySelector<HTMLButtonElement>('[data-weather-retry]');

  const setText = (selector: string, value: string | number) => {
    const element = card?.querySelector<HTMLElement>(selector);
    if (element) element.textContent = String(value);
  };

  const showState = (state: 'loading' | 'content' | 'error') => {
    if (loading) loading.hidden = state !== 'loading';
    if (content) content.hidden = state !== 'content';
    if (error) error.hidden = state !== 'error';
    card?.setAttribute('aria-busy', String(state === 'loading'));
  };

  const renderForecast = (forecast: ForecastDay[]) => {
    const container = card?.querySelector<HTMLElement>('[data-forecast]');
    if (!container) return;

    container.replaceChildren(...forecast.map((day) => {
      const item = document.createElement('div');
      item.className = 'last:col-span-2 rounded-xl bg-white/[.06] px-1.5 py-3 text-center sm:last:col-span-1';

      const label = document.createElement('p');
      label.className = 'text-[.68rem] font-bold text-white/45';
      label.textContent = day.label;

      const icon = document.createElement('span');
      icon.className = 'mt-2 block text-xl';
      icon.setAttribute('aria-hidden', 'true');
      icon.textContent = day.icon;

      const condition = document.createElement('p');
      condition.className = 'mt-1 truncate text-[.65rem] font-bold text-sun-300';
      condition.textContent = day.condition;

      const temperature = document.createElement('p');
      temperature.className = 'mt-2 text-xs font-extrabold';
      temperature.textContent = `${Math.round(day.maxTemperature)}°／${Math.round(day.minTemperature)}°`;

      const details = document.createElement('p');
      details.className = 'mt-1 text-[.62rem] text-white/40';
      details.textContent = `${day.sunrise} · 雨 ${Math.round(day.precipitationProbability)}%`;

      item.append(label);
      item.append(icon);
      item.append(condition);
      item.append(temperature);
      item.append(details);
      return item;
    }));
  };

  const isConditionsPayload = (value: unknown): value is ConditionsPayload => {
    if (!value || typeof value !== 'object') return false;
    const data = value as Partial<ConditionsPayload>;
    return data.status === 'ok'
      && typeof data.updatedAt === 'string'
      && Boolean(data.current && data.target && data.weather && data.recommendation)
      && Array.isArray(data.forecast)
      && data.forecast.length >= 3;
  };

  const renderAdvice = (advice: ConditionsAdvice) => {
    const panel = card?.querySelector<HTMLElement>('[data-advice]');
    if (!panel) return;
    panel.hidden = false;

    const risks = card?.querySelector<HTMLUListElement>('[data-advice-risks]');
    if (risks) {
      risks.replaceChildren(...advice.risks.map((text) => {
        const item = document.createElement('li');
        item.className = 'rounded-xl bg-red-500/15 px-3.5 py-2.5 text-xs font-bold leading-6 text-red-200';
        item.textContent = text;
        return item;
      }));
      risks.hidden = advice.risks.length === 0;
    }

    (['outfit', 'activity', 'gear'] as const).forEach((key) => {
      const group = card?.querySelector<HTMLElement>(`[data-advice-group="${key}"]`);
      const list = card?.querySelector<HTMLUListElement>(`[data-advice-list="${key}"]`);
      if (!group || !list) return;

      list.replaceChildren(...advice[key].map((text) => {
        const item = document.createElement('li');
        item.className = 'flex gap-2.5';
        const dot = document.createElement('span');
        dot.className = 'mt-2.5 size-1.5 shrink-0 rounded-full bg-sun-400';
        dot.setAttribute('aria-hidden', 'true');
        item.append(dot, document.createTextNode(text));
        return item;
      }));
      group.hidden = advice[key].length === 0;
    });
  };

  const renderConditions = (data: ConditionsPayload) => {
    setText('[data-current-icon]', data.current.icon);
    setText('[data-current-condition]', data.current.condition);
    setText('[data-current-temperature]', `${Math.round(data.current.temperature)}°`);
    setText('[data-current-apparent]', `${Math.round(data.current.apparentTemperature)}°`);
    setText('[data-current-humidity]', `${Math.round(data.current.humidity)}%`);
    setText('[data-current-gust]', `${Math.round(data.current.windGust)} km/h`);

    setText('[data-target-date]', `${data.target.dateLabel}・${data.weather.condition}`);
    setText('[data-target-icon]', data.weather.icon);
    setText('[data-target-condition]', data.weather.condition);
    setText('[data-recommendation-title]', data.recommendation.title);
    setText('[data-recommendation-summary]', data.recommendation.summary);
    setText('[data-score]', data.recommendation.score);
    setText('[data-sunrise]', data.target.sunrise);
    setText('[data-dawn]', data.target.civilDawn);
    setText('[data-arrive]', data.target.arriveBy);
    setText('[data-cloud]', Math.round(data.weather.cloudCover));
    setText('[data-humidity]', Math.round(data.weather.humidity));
    setText('[data-wind]', data.weather.windSpeed);
    setText('[data-visibility]', data.weather.visibilityKm);
    setText('[data-rain]', Math.round(data.weather.precipitationProbability));
    setText('[data-temperature]', Math.round(data.weather.temperature));
    setText('[data-disclaimer]', data.disclaimer);

    const scoreRing = card?.querySelector<HTMLElement>('[data-score-ring]');
    if (scoreRing) {
      scoreRing.style.background = `conic-gradient(#eeb55a ${data.recommendation.score * 3.6}deg, rgba(255,255,255,.1) 0deg)`;
    }

    const updatedAt = new Date(data.updatedAt);
    setText('[data-updated]', `更新 ${new Intl.DateTimeFormat('zh-TW', {
      month: 'numeric',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false
    }).format(updatedAt)}`);

    const source = card?.querySelector<HTMLAnchorElement>('[data-source]');
    if (source) {
      source.textContent = data.source.name;
      source.href = data.source.url;
    }

    if (data.advice) renderAdvice(data.advice);

    renderForecast(data.forecast);
    showState('content');
  };

  const loadConditions = async () => {
    showState('loading');
    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 12000);

    try {
      const response = await fetch('/api/conditions', {
        headers: { Accept: 'application/json' },
        signal: controller.signal
      });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const data: unknown = await response.json();
      if (!isConditionsPayload(data)) throw new Error('Invalid weather response');
      renderConditions(data);
    } catch {
      showState('error');
    } finally {
      window.clearTimeout(timeout);
    }
  };

  retry?.addEventListener('click', loadConditions);
  void loadConditions();
</script>
